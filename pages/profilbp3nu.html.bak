                <div class="card mb-0">
                    <div class="card-header" style="background: var(--primary-dark);">
                        <h3 style="font-size: 1rem;"><i class="fas fa-bolt"></i> Fokus SMP & SMA</h3>
                    </div>
                    <div class="card-body p-0">
                        <table style="font-size: 0.85rem;">
                            <tbody>
                                <tr>
                                    <td>SMP</td>
                                    <td>Leadership & OSIS</td>
                                </tr>
                                <tr>
                                    <td>SMA</td>
                                    <td>SMARTBA Berbagi</td>
