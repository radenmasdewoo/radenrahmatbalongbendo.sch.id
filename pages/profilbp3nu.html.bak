    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
        const menuBtn = document.getElementById('menu-btn');
        const navList = document.querySelector('.nav-menu');
        if (menuBtn && navList) {
            menuBtn.addEventListener('click', () => {
                navList.classList.toggle('active');
            });
        }

        // WA Contact: toggle pilihan PPDB saat tombol CHAT WHATSAPP diklik
        const waMainBtn = document.getElementById('wa-main-btn');
        const waOptionsBox = document.getElementById('wa-options');
        if (waMainBtn && waOptionsBox) {
            waMainBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const isVisible = waOptionsBox.style.display === 'block';
                waOptionsBox.style.display = isVisible ? 'none' : 'block';
            });
        }

        /* ── Traffic Monitor Sidebar ── api/live_stats.php (GA4) ── */
        (function () {
            var API = 'https://radenrahmatbalongbendo.sch.id/api/live_stats.php';
            var REFRESH_MS = 30000;

            function q(id) { return document.getElementById(id); }

            function tickSide() {
                var el = q('side-time');
                if (el) el.textContent = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            }

            function renderSideChart(chart7d) {
                var c = q('side-chart');
                if (!c) return;
                if (!Array.isArray(chart7d) || !chart7d.length) {
                    c.innerHTML = '<span style="font-size:10px;color:#aaa;">Tidak ada data</span>';
                    return;
                }
                c.innerHTML = chart7d.map(function (b, i) {
                    var h = Math.max(b.height_pct || 5, 4);
                    var cls = i === chart7d.length - 1 ? 'today-s' : 'normal-s';
                    return '<div class="tm-sbar-col">' +
                        '<div class="tm-sbar ' + cls + '" style="height:' + h + '%" title="' + (b.sessions || 0) + ' sesi"></div>' +
                        '<div class="tm-sbar-lbl">' + (b.label || '') + '</div>' +
                        '</div>';
                }).join('');
            }

            function fetchSideStats() {
                fetch(API + '?_=' + Date.now())
                    .then(function (r) { return r.ok ? r.json() : Promise.reject('HTTP ' + r.status); })
                    .then(function (d) {
                        var o = q('side-online'), t = q('side-today'), tot = q('side-total');
                        if (o) o.textContent = d.active_users_fmt || '0';
                        if (t) t.textContent = d.today_fmt || '0';
                        if (tot) tot.textContent = d.total_fmt || '0';
                        renderSideChart(d.chart_7d || []);
                        [o, t, tot].forEach(function (el) {
                            if (!el) return;
                            el.style.transition = 'opacity .3s';
                            el.style.opacity = '.5';
                            setTimeout(function () { el.style.opacity = '1'; }, 350);
                        });
                    })
                    .catch(function (err) {
                        console.warn('[TM Sidebar] Gagal memuat data:', err);
                        ['side-online', 'side-today', 'side-total'].forEach(function (id) {
                            var el = q(id);
                            if (el && el.textContent === '...') el.textContent = '—';
                        });
                    });
            }

