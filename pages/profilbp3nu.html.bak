                <a href="#" class="social-btn" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" class="social-btn" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="nav-bar">
        <div class="container nav-inner">
            <div class="mobile-toggle" id="menu-btn"><i class="fas fa-bars"></i></div>
            <ul class="nav-menu">
                <li><a href="../index.html">Beranda</a></li>
                <li><a href="profilbp3nu.html" class="active">Profil BP3NU</a></li>
                <li class="has-dropdown">
                    <a href="#">Unit Pendidikan <i class="fas fa-chevron-down"
                            style="font-size: 0.7rem; margin-left: 5px;"></i></a>
                    <div class="dropdown">
                        <a href="https://mi.radenrahmatbalongbendo.sch.id/">MI RADEN RAHMAT</a>
                        <a href="https://smp.radenrahmatbalongbendo.sch.id/">SMP R RAHMAT</a>
