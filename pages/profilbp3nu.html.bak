    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        media="print" onload="this.media='all'">
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    </noscript>

    <style>
        /* --- DESIGN SYSTEM & VARIABLES --- */
        :root {
            --primary: #006837;
            --primary-dark: #004d29;
            --primary-light: #e6f4ea;
            --accent: #f39c12;
            --accent-dark: #d35400;
            --text-main: #2c3e50;
            --text-muted: #7f8c8d;
            --white: #ffffff;
            --bg-body: #f8f9fa;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            height: 100%;
            scroll-behavior: smooth;
            overflow-x: hidden;
            width: 100%;
        }

        body {
            height: 100%;
            font-family: 'Roboto', sans-serif;
            color: var(--text-main);
            line-height: 1.7;
            background: url('../bgfull_smp.webp') no-repeat center center fixed;
            background-size: cover;
            overflow-x: hidden;
            width: 100%;
            position: relative;
        }

        h1,
        h2,
        h3,
        h4,
        .nav-menu li a {
            font-family: 'Outfit', sans-serif;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
        }

        ul {
            list-style: none;
        }

        .container {
            width: 92%;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* --- TOP BAR --- */
        .top-bar {
            background-color: #111;
            color: #bdc3c7;
            font-size: 0.8rem;
            padding: 10px 0;
            border-bottom: 1px solid #333;
        }

        .top-bar .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-info span {
            margin-right: 15px;
        }

        /* --- HEADER --- */
        header {
            background-color: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            padding: 25px 0;
            position: relative;
        }

        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }

        .logo-text {
            display: flex;
            flex-direction: column;
        }

        .logo-area h1 {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: -1px;
            line-height: 1;
        }

        .logo-area p {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .header-tools {
            display: flex;
            gap: 15px;
        }

        .social-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 1.1rem;
        }

        .social-btn:hover {
            background: var(--primary);
            color: var(--white);
            transform: translateY(-3px);
        }

        /* --- NAVIGATION --- */
        .nav-bar {
            background-color: rgba(0, 104, 55, 0.9);
            backdrop-filter: blur(8px);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: top 0.3s ease;
        }

        .nav-hidden {
            top: -80px !important;
        }

        .nav-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-menu {
            display: flex;
        }

        .nav-menu li a {
            padding: 18px 25px;
            display: block;
            color: var(--white);
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .nav-menu li a:hover {
            background-color: var(--primary-dark);
        }

        .nav-menu .active {
            background-color: var(--primary-dark);
            border-bottom: 3px solid var(--accent);
        }

        .has-dropdown {
            list-style: none;
            position: relative;
        }

        .nav-menu li {
            position: relative;
        }

        .dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            min-width: 250px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            border-radius: 0 0 10px 10px;
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1001;
            animation: fadeInDown 0.3s ease;
        }

        .nav-menu li:hover .dropdown {
            display: flex;
        }

        .dropdown a {
            padding: 15px 25px !important;
            color: var(--text-main) !important;
            border-bottom: 1px solid #f9f9f9;
            text-transform: none !important;
            font-size: 0.85rem !important;
            letter-spacing: 0 !important;
            display: flex !important;
            align-items: center;
            gap: 10px;
        }

        .dropdown a:hover {
            background: var(--primary-light) !important;
            color: var(--primary) !important;
            padding-left: 30px !important;
        }

        .dropdown a i {
            color: var(--accent);
            width: 20px;
        }

        .menu-logo {
            width: 20px;
            height: auto;
            object-fit: contain;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .ppdb-btn {
            background: #ffcc00;
            color: #000 !important;
            font-weight: 800;
            position: relative;
            overflow: hidden;
            border: none;
            box-shadow: 0 0 10px rgba(255, 204, 0, 0.5);
            animation: fire-pulse 1.5s infinite alternate;
        }

        @keyframes fire-pulse {
            0% {
                background-color: #ffcc00;
                box-shadow: 0 0 5px #ffcc00, 0 0 10px #ffcc00;
            }

            50% {
                background-color: #ffeb3b;
                box-shadow: 0 0 15px #ffeb3b, 0 0 30px #ff9800;
            }

            100% {
                background-color: #ff9800;
                box-shadow: 0 0 10px #ff9800, 0 0 20px #ff5722;
            }
        }

        /* --- HERO SECTION --- */
        .hero {
            position: relative;
            height: 300px;
            overflow: hidden;
            display: flex;
            align-items: center;
        }

        .hero-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.7);
        }

        .hero-content {
            position: relative;
            z-index: 10;
            max-width: 800px;
            padding: 40px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            border-left: 5px solid var(--accent);
            border-radius: 0 20px 20px 0;
            color: var(--white);
        }

        .hero-content h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        /* --- MAIN CONTENT --- */
        .main-wrapper {
            display: grid;
            grid-template-columns: 2.8fr 1.2fr;
            gap: 30px;
            margin: 40px auto;
        }

        .card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            border-radius: 16px;
            box-shadow: var(--card-shadow);
            margin-bottom: 30px;
            overflow: hidden;
        }

        .card-header {
            padding: 15px 25px;
            background: linear-gradient(to right, var(--primary), var(--primary-dark));
            color: var(--white);
        }

        .card-header h3 {
            font-size: 1.2rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-body {
            padding: 30px;
            line-height: 1.8;
        }

        .card-body p {
            margin-bottom: 20px;
        }

        .card-body h4 {
            margin: 25px 0 15px;
            color: var(--primary);
            border-bottom: 2px solid var(--primary-light);
            display: inline-block;
        }

        /* --- TABLES --- */
        .table-responsive {
            overflow-x: auto;
            margin: 20px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            background: white;
        }

        th {
            background: var(--primary);
            color: white;
            padding: 15px;
            text-align: left;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        /* --- TRAFFIC MONITOR SIDEBAR STYLES --- */
        .tm-sidebar-card {
            background: #fff;
            border-radius: 12px;
            padding: 15px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            font-family: inherit;
            margin-top: 0;
        }

        .tm-sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #d4e8db;
            padding-bottom: 10px;
            margin-bottom: 12px;
        }

        .tm-sidebar-title {
            color: #1a5c38;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .tm-live-indicator {
            color: #27ae60;
            font-size: 10px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .tm-live-dot-s {
            width: 7px;
            height: 7px;
            background: #27ae60;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 5px #27ae60;
            animation: tmPulseSide 1.5s ease-in-out infinite;
        }

        @keyframes tmPulseSide {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: .5;
                transform: scale(.8);
            }
        }

        .tm-stats-grid-small {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }

        .tm-stat-box {
            background: #f4faf6;
            padding: 9px 8px;
            border-radius: 8px;
            border: 1px solid #d4e8db;
            text-align: center;
        }

        .tm-stat-box .label {
            font-size: 10px;
            color: #777;
            display: block;
            margin-bottom: 2px;
        }

        .tm-stat-box .value {
            font-size: 15px;
            font-weight: 700;
            color: #1a5c38;
            display: block;
        }

        .tm-section-label {
            font-size: 10px;
            font-weight: 700;
            color: #999;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 7px;
            display: block;
        }

        .tm-chart-sidebar {
            height: 80px;
            background: #f4faf6;
            border: 1px solid #d4e8db;
            border-radius: 6px;
            margin-bottom: 12px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 4px;
            padding: 8px 6px 4px;
            overflow: hidden;
        }

        .tm-sbar-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            height: 100%;
            justify-content: flex-end;
        }

        .tm-sbar {
            width: 100%;
            border-radius: 3px 3px 0 0;
            min-height: 3px;
            transition: height 1s cubic-bezier(.34, 1.56, .64, 1);
        }

        .tm-sbar.today-s {
            background: linear-gradient(to top, #1a5c38, #4caf78);
        }

        .tm-sbar.normal-s {
            background: linear-gradient(to top, #a8d5b5, #d4e8db);
        }

        .tm-sbar-lbl {
            font-size: 7px;
            color: #aaa;
            text-align: center;
            line-height: 1;
        }

        .tm-device-row {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            padding: 5px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .tm-device-name {
            color: #444;
        }

        .tm-device-pct {
            font-weight: 700;
            color: #1a5c38;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
            font-size: 0.95rem;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:nth-child(even) {
            background: #fbfbfb;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .widget {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
        }

        .widget-title {
            background: rgba(248, 249, 250, 0.5);
            padding: 15px 20px;
            border-bottom: 2px solid var(--primary-light);
            color: var(--primary);
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.9rem;
        }

        .widget-content {
            padding: 20px;
        }

        .link-list li a {
            padding: 12px 0;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid #f9f9f9;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .link-list li a:hover {
            padding-left: 10px;
            color: var(--primary);
        }

        .link-list li a i {
            color: var(--accent);
            width: 20px;
        }

        /* --- FOOTER --- */
        footer {
            background: #111;
            color: #bdc3c7;
            padding: 60px 0 120px;
            margin-top: 60px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1.5fr;
            gap: 50px;
        }

        .footer-col h4 {
            color: var(--white);
            font-size: 1.3rem;
            margin-bottom: 25px;
            position: relative;
        }

        .footer-col h4::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -8px;
            width: 40px;
            height: 3px;
            background: var(--accent);
        }

        .copyright {
            padding-top: 30px;
            border-top: 1px solid #222;
            text-align: center;
            font-size: 0.9rem;
            margin-top: 40px;
        }

        .map-box {
            width: 100%;
            height: 180px;
            min-height: 180px;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 12px;
            margin-top: 10px;
            overflow: hidden;
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .map-box:hover {
            border-color: var(--accent);
        }

        .map-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        @media (max-width: 992px) {
            .main-wrapper {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .hero {
                height: auto;
            }

            .hero-content {
                padding: 20px;
                margin: 20px;
                border-radius: 12px;
            }

            .hero-content h2 {
                font-size: 1.5rem;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <!-- Google Tag Manager (noscript) -->
