    <style>
        /* --- PREMIUM DESIGN SYSTEM --- */
        :root {
            --primary: #1b5e20;
            /* Deep Green */
            --primary-dark: #0d3810;
            --primary-light: #e8f5e9;
            --accent: #ffc107;
            /* Amber/Gold */
            --accent-dark: #e5af06;
            --text-main: #2c3e50;
            --text-muted: #607d8b;
            --white: #ffffff;
            --bg-body: #fafafa;
            --card-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
            color: var(--text-main);
            background-color: var(--bg-body);
            background-image: url('BG_mi.webp');
            background-attachment: fixed;
            background-size: cover;
            background-position: center;
        }

        /* Navbar */
        .navbar {
            background: linear-gradient(135deg, rgba(27, 94, 32, 0.9), rgba(13, 56, 16, 0.9)) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            padding: 15px 0;
        }

        .navbar-brand img {
            height: 60px;
            width: auto;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
        }

        .nav-link {
            font-weight: 500;
            color: rgba(255, 255, 255, 0.9) !important;
            margin: 0 10px;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            transition: var(--transition);
        }

        .nav-link:hover {
            color: var(--accent) !important;
            transform: translateY(-2px);
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(0, 50, 0, 0.75), rgba(0, 50, 0, 0.75)),
                url('hero-bg.webp');
            background-size: cover;
            background-position: center;
            height: 90vh;
            display: flex;
            align-items: center;
            color: white;
            text-align: center;
            position: relative;
            /* Smooth feathered transition to body background */
            -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
            mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
        }

        .section-title {
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 50px;
            text-align: center;
            position: relative;
            display: inline-block;
            left: 50%;
            transform: translateX(-50%);
        }

        .section-title::after {
            content: '';
            width: 60px;
            height: 6px;
            background: var(--accent);
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            border-radius: 3px;
        }

        /* PPDB Card */
        .card-ppdb {
            border: none;
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            background: rgba(255, 255, 255, 0.7) !important;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .btn-ppdb {
            background: linear-gradient(45deg, var(--accent), var(--accent-dark));
            color: #212529;
            font-weight: 700;
            border-radius: 50px;
            padding: 15px 40px;
            border: none;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-ppdb:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(243, 156, 18, 0.6);
            color: #000;
        }

        /* Icons */
        .text-success {
            color: var(--primary) !important;
        }

        .feature-icon-box {
            background: var(--primary-light);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            color: var(--primary);
            font-size: 1.5rem;
            transition: var(--transition);
        }

        .d-flex:hover .feature-icon-box {
            background: var(--primary);
            color: var(--white);
            transform: rotateY(360deg);
        }

        footer {
            background: #1a1a1a;
            color: white;
            padding: 80px 0 30px;
        }

        .ig-feed-box {
            border: 2px dashed #ddd;
            border-radius: 20px;
            padding: 40px;
            background: white;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transition: var(--transition);
        }

        .ig-feed-box:hover {
            border-color: var(--accent);
            transform: translateY(-5px);
        }

        /* IG horizontal marquee */
        .ig-marquee-wrapper {
            overflow: hidden;
            position: relative;
            width: 100%;
        }

        .ig-marquee-track {
            display: flex;
            gap: 20px;
            width: max-content;
            will-change: transform;
            animation: ig-marquee 30s linear infinite;
        }

        .ig-marquee-track:hover {
            animation-play-state: paused;
        }

        .ig-feed-container {
            min-height: 200px;
        }

        .ig-card {
            min-width: 220px;
            max-width: 220px;
            background: rgba(255, 255, 255, 0.6) !important;
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            flex-shrink: 0;
            text-decoration: none;
            color: inherit;
            display: block;
            transition: var(--transition);
        }

        .ig-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

        .ig-card img,
        .ig-card video.ig-video {
            width: 100%;
            height: 180px;
            object-fit: cover;
            display: block;
        }

        .ig-card-body {
            padding: 10px 12px;
        }

        .ig-card-title {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .ig-card-meta {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        /* Instagram Section Enhancements */
        .insta-placeholder {
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 30px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .insta-content {
            position: relative;
            z-index: 2;
        }

        /* Instagram Header Refinement */
        .ig-header-card {
            display: inline-flex;
            align-items: center;
            padding: 12px 25px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none !important;
            border: 1px solid rgba(0, 0, 0, 0.05);
            margin-bottom: 2rem;
        }

        .ig-header-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(225, 48, 108, 0.2);
            border-color: #E1306C;
        }

        .ig-icon {
            font-size: 2.5rem;
            background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-right: 18px;
            line-height: 1;
        }

        .ig-text h5 {
            margin: 0;
            font-size: 1.2rem;
            color: #1a1a1a;
            font-weight: 700;
        }

        .ig-text small {
            color: #666;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .text-fire {
            font-size: 1.1rem !important;
            font-weight: 700;
            color: #ff4500 !important;
            /* Bright Orange-Red */
            text-shadow: 0 0 10px #ff8c00, 0 0 20px #ff4500;
            display: inline-block;
            animation: fire-flicker 1.5s infinite alternate;
        }

        @keyframes fire-flicker {
            from {
                text-shadow: 0 0 10px #ff8c00;
            }

            to {
                text-shadow: 0 0 20px #ff4500, 0 0 30px #ffa500;
            }
        }

        @keyframes ig-marquee {
            from {
                transform: translateX(-50%);
            }

            to {
                transform: translateX(0);
            }
        }

        /* Form */
        .form-control {
            padding: 12px 15px;
            border-radius: 10px;
            border: 2px solid #eee;
        }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.15);
        }

        /* Fire Button Effect */
        .btn-fire {
            background: linear-gradient(45deg, var(--accent), var(--accent-dark)) !important;
            color: #212529 !important;
            border: none !important;
            box-shadow: 0 4px 15px rgba(243, 156, 18, 0.4);
            transition: all 0.3s ease !important;
            display: inline-block;
            text-decoration: none;
        }

        .btn-fire:hover {
            background: linear-gradient(45deg, #f00000, #dc281e, #ff8000) !important;
            box-shadow: 0 0 20px rgba(240, 0, 0, 0.8), 0 0 40px rgba(255, 128, 0, 0.6) !important;
            transform: scale(1.05) translateY(-2px) !important;
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.8) !important;
        }

        .section-glass {
            background-color: rgba(255, 255, 255, 0.6) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 20px;
            margin: 20px 0;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        /* Mobile Scale-down */
        @media (max-width: 991px) {
            .navbar-collapse {
                display: flex !important;
                flex-basis: auto;
            }

            .navbar-nav {
                flex-direction: row !important;
                align-items: center;
            }

            .nav-item {
                margin: 0 2px !important;
            }

            .nav-link {
                padding: 0.3rem 0.4rem !important;
                font-size: 0.65rem !important;
            }

            .btn-fire {
                padding: 0.3rem 0.6rem !important;
                font-size: 0.6rem !important;
            }

            .navbar-brand img {
                height: 35px !important;
            }

            .brand-text span {
                font-size: 0.75rem !important;
            }

            .brand-text small {
                font-size: 0.5rem !important;
            }

            .container-fluid {
                padding-left: 10px !important;
                padding-right: 10px !important;
            }
        }
    </style>
</head>

<body>
