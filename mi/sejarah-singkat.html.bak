    <style>
        .timeline-section {
            padding-top: 3rem;
            padding-bottom: 3rem;
        }

        .timeline-badge {
            background-color: #1b5e20;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 20px;
        }

        .info-card {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            border-bottom: 3px solid #1b5e20;
        }

        .info-title {
            color: #1b5e20;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .info-value {
            font-weight: 600;
            color: #333;
            font-size: 1rem;
        }

        .timeline-container {
            position: relative;
            padding-left: 50px;
            margin-top: 40px;
        }

        .timeline-container::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 2px;
            background-color: rgba(0, 0, 0, 0.1);
        }

        .timeline-item {
            position: relative;
            margin-bottom: 30px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            border-left: 4px solid #1b5e20;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -37px;
            top: 25px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background-color: #ffc107;
            border: 3px solid white;
            box-shadow: 0 0 0 2px #1b5e20;
        }

        .timeline-date {
            color: #555;
            font-size: 0.85rem;
            font-weight: bold;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .timeline-content h4 {
            color: #1b5e20;
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .timeline-content p {
            color: #444;
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 0;
        }

        .decorative-diamonds {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin: 40px 0;
        }

        .diamond {
            width: 8px;
            height: 8px;
            background-color: #d4af37;
            transform: rotate(45deg);
        }

        .filosofi-card {
            text-align: center;
            padding: 30px 20px;
        }

