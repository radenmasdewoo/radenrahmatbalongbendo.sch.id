    <script>
        function kirimPendaftaran() {
            const noAdmin = "6285730017464";

            // Ambil dan bersihkan data (limit karakter untuk keamanan)
            const anak = document.getElementById('namaAnak').value.trim().substring(0, 200);
            const asal = document.getElementById('asalSekolah').value.trim().substring(0, 200);
            const wali = document.getElementById('namaWali').value.trim().substring(0, 200);
            const alamat = document.getElementById('alamat').value.trim().substring(0, 500);

            if (anak && wali && alamat) {
                // Gunakan encodeURIComponent agar karakter khusus (seperti &, #, ?) tidak memutus link
                const greeting = "Assalamualaikum admin PPDB";
                const isiPesan = `${greeting},\n\n` +
                    `Saya ingin mendaftarkan calon siswa baru:\n` +
                    `*Nama Anak:* ${anak}\n` +
                    `*Asal Sekolah:* ${asal}\n` +
                    `*Nama Wali:* ${wali}\n` +
                    `*Alamat:* ${alamat}\n\n` +
                    `Mohon informasi langkah pendaftaran selanjutnya. Terima kasih.`;

                const urlWA = `https://wa.me/${noAdmin}?text=${encodeURIComponent(isiPesan)}`;
                window.open(urlWA, '_blank');
            } else {
                alert("Mohon lengkapi formulir pendaftaran!");
            }
        }
    </script>

    <script>
        // Load IG feed from local API and tampilkan sebagai marquee horizontal
        (function () {
            const container = document.querySelector('.ig-feed-container');
            const loadingEl = document.getElementById('ig-loading');
            if (!container) return;

            fetch('api/news_mi.php')
                .then(res => res.json())
                .then(data => {
                    if (!Array.isArray(data) || data.length === 0) {
                        if (loadingEl) loadingEl.innerHTML = '<p class="text-center text-muted mb-0">Belum ada postingan.</p>';
                        return;
                    }

                    const posts = data
                        .slice() // copy
                        .sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0))
                        .slice(0, 10);

                    const trackItems = posts.map(p => {
                        const safeTitle = (p.title || 'Post Instagram');
                        const safeExcerpt = (p.excerpt || p.caption || '');
                        const safeDate = (p.date || '');
                        const sc = p.shortcode || '';
                        const link = p.link || `https://www.instagram.com/p/${sc}/`;

                        const isVideo = p.is_video === true;

                        const getProxyUrl = (url, kind) => {
                            if (!url) return `api/image_proxy.php?shortcode=${sc}&kind=${kind}`;
                            if (/scontent|cdninstagram|fbcdn/i.test(url)) return `api/image_proxy.php?url=${encodeURIComponent(url)}&shortcode=${sc}&kind=${kind}`;
                            return url;
                        };

                        const imgSrc = getProxyUrl(p.img, 'image');
                        const vidSrc = isVideo ? getProxyUrl(p.video, 'video') : '';

                        let mediaHtml = '';
                        if (isVideo) {
                            mediaHtml = `
                                <div class="ig-card-media" style="position:relative;">
                                    <video 
                                        class="ig-video" 
                                        src="${vidSrc}" 
                                        poster="${imgSrc}" 
                                        autoplay 
                                        muted 
                                        loop 
                                        playsinline 
                                        preload="auto"
                                        style="width:100%;height:160px;object-fit:cover;"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                    ></video>
                                    <img src="${imgSrc}" style="width:100%;height:160px;object-fit:cover;display:none;" 
                                         onerror="this.onerror=null; this.src='api/image_proxy.php?shortcode=${sc}&kind=image'">
                                    <div style="position:absolute;top:10px;right:10px;color:white;text-shadow:0 0 4px rgba(0,0,0,0.8);"><i class="fas fa-play-circle"></i></div>
                                </div>`;
                        } else {
                            mediaHtml = `
                                <div class="ig-card-media">
                                    <img src="${imgSrc}" alt="${safeTitle.replace(/"/g, '&quot;')}" loading="lazy" 
                                         style="width:100%;height:160px;object-fit:cover;display:block;"
                                         onerror="this.onerror=null; this.src='api/image_proxy.php?shortcode=${sc}&kind=image'">
                                </div>`;
                        }

                        return `
                            <a class="ig-card" href="${link}" target="_blank" rel="noopener noreferrer">
                                ${mediaHtml}
                                <div class="ig-card-body">
                                    <div class="ig-card-title text-truncate" title="${safeTitle}">${safeTitle}</div>
                                    <div class="small text-muted mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;height:2.8em;line-height:1.4em;font-size:0.75rem;">${safeExcerpt}</div>
                                    <div class="ig-card-meta"><i class="far fa-calendar-alt me-1"></i>${safeDate}</div>
                                </div>
                            </a>
                        `;
                    }).join('');

                    const html = `
                        <div class="ig-marquee-wrapper">
                            <div class="ig-marquee-track" id="smp-ig-track">
                                ${trackItems}
                                ${trackItems}
                            </div>
                        </div>
                    `;

                    container.innerHTML = html;

                    // Paksa autoplay untuk semua video (muted)
                    const videos = container.querySelectorAll('video.ig-video');
                    const tryPlayAll = () => {
                        videos.forEach(v => {
                            v.play().catch(() => { });
                        });
                    };
                    tryPlayAll();
                    ['click', 'touchstart'].forEach(evt => {
                        document.addEventListener(evt, () => {
                            tryPlayAll();
                        }, { once: true });
                    });
                })
                .catch(err => {
                    console.error('Gagal load IG feed MI:', err);
                    if (loadingEl) {
                        loadingEl.innerHTML = '<p class="text-center text-danger mb-0">Gagal memuat feed Instagram.</p>';
                    }
                });
        })();
    </script>

