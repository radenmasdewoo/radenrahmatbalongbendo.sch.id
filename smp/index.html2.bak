    <script>
        // Global helper for image proxying
        const checkNeedsProxy = (url) => /scontent|cdninstagram|fbcdn|instagram/i.test(url);

        function kirimFormulir() {
            // Nomor Admin SMP
            const nomorAdmin = "6285706673560";

            const nama = document.getElementById('nama').value;
            const sekolah = document.getElementById('sekolah').value;
            const ortu = document.getElementById('ortu').value;
            const hp = document.getElementById('hp').value;

            if (nama && sekolah && ortu && hp) {
                const pesan = `Halo Admin PPDB SMP Raden Rahmat,%0A%0A` +
                    `Saya ingin mendaftarkan calon siswa baru dengan data berikut:%0A` +
                    `*Nama Siswa:* ${nama}%0A` +
                    `*Asal Sekolah:* ${sekolah}%0A` +
                    `*Nama Ortu:* ${ortu}%0A` +
                    `*Nomor HP:* ${hp}%0A%0A` +
                    `Mohon informasinya lebih lanjut. Terima kasih.`;

                window.open(`https://wa.me/${nomorAdmin}?text=${pesan}`, '_blank');
            } else {
                alert("Mohon lengkapi semua data formulir terlebih dahulu.");
            }
        }
    </script>

    <script>
        // Load IG feed SMP — baca dari ig_cache/data.json (lokal cache)
        // fallback ke api/news.php jika data.json belum ada
        (function () {
            const container = document.querySelector('.ig-feed-container');
            const loadingEl = document.getElementById('smp-ig-loading');
            const prestasiListEl = document.getElementById('prestasi-list');
            if (!container) return;

            console.log('[START] Memuat tampilan feed Instagram SMP...');

            // Coba data.json lokal dulu, lalu news.php sebagai fallback
            const sources = ['api/ig_cache/data.json', 'api/news.php'];

            async function tryLoad() {
                let data = null;
                for (const src of sources) {
                    try {
                        const res = await fetch(src + '?cb=' + Date.now());
                        if (!res.ok) continue;
                        const json = await res.json();
                        if (Array.isArray(json) && json.length > 0) {
                            data = json;
                            console.log('[START] Data dimuat dari:', src);
                            break;
                        }
                    } catch (e) { /* coba sumber berikutnya */ }
                }
                return data;
            }

            tryLoad().then(data => {
                if (!data || data.length === 0) {
                    if (loadingEl) loadingEl.innerHTML = '<p class="text-center text-muted mb-0">Belum ada postingan.</p>';
                    if (prestasiListEl) prestasiListEl.innerHTML = '<p class="mb-0 text-muted small">Belum ada prestasi yang tercatat.</p>';
                    return;
                }

                // Urutkan terbaru dulu, ambil 10 & filter (no text)
                const posts = data.slice()
                    .filter(p => {
                        const t = (p.title || '').toLowerCase();
                        return t && !t.includes('(no text)') && t !== 'post instagram';
                    })
                    .sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0))
                    .slice(0, 10);

                // Prestasi Terbaru
                if (prestasiListEl) {
                    const filteredPosts = posts.filter(p => {
                        const t = (p.title || '').toLowerCase();
                        return t && !t.includes('(no text)') && t !== 'post instagram';
                    });
                    prestasiListEl.innerHTML = filteredPosts.slice(0, 5).map(p => {
                        const t = (p.title || 'Post Instagram').replace(/▶\s*/, '');
                        return `<div class="mb-1"><i class="fas fa-medal text-warning me-2"></i>${t}</div>`;
                    }).join('') || '<p class="mb-0 text-muted small">Belum ada prestasi yang tercatat.</p>';
                }

                // Helper: apakah URL butuh diproxy?
                const needsProxy = (url) => /scontent|cdninstagram|fbcdn/i.test(url) && /^https?:\/\//i.test(url);
                const proxyUrl = (url, sc, kind) => {
                    if (!url) return sc ? `api/image_proxy.php?shortcode=${sc}&kind=${kind || 'image'}` : '';
                    if (needsProxy(url)) return `api/image_proxy.php?url=${encodeURIComponent(url)}${sc ? '&shortcode=' + sc : ''}`;
                    return url;
                };

                const buildCard = (p) => {
                    const safeTitle = (p.title || 'Post Instagram').replace(/▶\s*/, '').replace(/"/g, '&quot;');
                    const safeDate = p.date || '';
                    const link = p.link || 'https://www.instagram.com/osis_smprrahmat/';
                    const sc = p.shortcode || '';

                    // Deteksi video
                    const isVideo = p.is_video === true || p.media_type === 'video' || (link.includes('/reel/'));
                    const hasVideoUrl = isVideo && p.video;

                    // URL gambar — lokal cache diutamakan, lalu proxy CDN
                    const imgSrc = proxyUrl(p.img, sc, 'image');

                    let mediaHtml = '';

                    if (hasVideoUrl) {
                        // Ada file video lokal
                        const videoSrc = needsProxy(p.video) ? proxyUrl(p.video, sc, 'video') : p.video;
                        mediaHtml = `
                            <video
                                src="${videoSrc}"
                                poster="${imgSrc}"
                                autoplay muted loop playsinline preload="auto"
                                class="ig-video"
                                style="width:100%;height:160px;object-fit:cover;display:block;"
                                onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='block';"
                            ></video>
                            <img src="${imgSrc}" alt="${safeTitle}"
                                style="width:100%;height:160px;object-fit:cover;display:none;"
                                onerror="this.src='https://via.placeholder.com/400x400/006837/ffffff?text=SMP'">
                            <div class="ig-card-video-badge"><i class="fas fa-play-circle"></i></div>`;
                    } else if (isVideo) {
                        // Video tanpa file lokal — tampilkan thumbnail + ikon play
                        mediaHtml = `
                            <img src="${imgSrc}" alt="${safeTitle}"
                                style="width:100%;height:160px;object-fit:cover;display:block;"
                                onerror="this.onerror=null; this.src='${sc ? 'api/image_proxy.php?shortcode=' + sc + '&kind=image' : 'https://via.placeholder.com/400x400/006837/ffffff?text=SMP'}'">
                            <div class="ig-card-video-badge"><i class="fas fa-play-circle"></i></div>`;
                    } else {
                        // Gambar biasa
                        mediaHtml = `
                            <img src="${imgSrc}" alt="${safeTitle}" loading="lazy"
                                style="width:100%;height:160px;object-fit:cover;display:block;"
                                onerror="this.onerror=null; this.src='${sc ? 'api/image_proxy.php?shortcode=' + sc + '&kind=image' : 'https://via.placeholder.com/400x400/006837/ffffff?text=SMP'}'">`;
                    }

                    return `
                        <a class="ig-card" href="${link}" target="_blank" rel="noopener noreferrer">
                            <div class="ig-card-media">${mediaHtml}</div>
                            <div class="ig-card-body">
                                <div class="ig-card-title text-truncate" title="${safeTitle}">${safeTitle}</div>
                                <div class="ig-card-meta"><i class="far fa-calendar-alt me-1"></i>${safeDate}</div>
                            </div>
                        </a>`;
                };

                const trackItems = posts.map(buildCard).join('');
                container.innerHTML = `
                    <div class="ig-marquee-wrapper">
                        <div class="ig-marquee-track" id="smp-ig-track">
                            ${trackItems}
                            ${trackItems}
                        </div>
                    </div>`;

                // Autoplay video setelah render
                const tryPlayAll = () => {
                    container.querySelectorAll('video.ig-video').forEach(v => {
                        v.muted = true;
                        v.play().catch(() => { });
                    });
                };
                setTimeout(tryPlayAll, 300);
                ['click', 'touchstart', 'scroll'].forEach(evt => {
                    document.addEventListener(evt, tryPlayAll, { once: true, passive: true });
                });

                // Pause marquee saat hover
                const track = document.getElementById('smp-ig-track');
                if (track) {
                    track.addEventListener('mouseenter', () => track.style.animationPlayState = 'paused');
                    track.addEventListener('mouseleave', () => track.style.animationPlayState = 'running');
                }

                console.log('[SUCCESS] Tampilan feed diperbarui. Total:', posts.length, 'post.');
            }).catch(err => {
                console.error('[ERROR] Gagal memuat JSON:', err);
                if (loadingEl) loadingEl.innerHTML = '<p clas