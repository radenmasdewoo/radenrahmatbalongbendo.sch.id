    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Animation CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        /* --- MODERN ISLAMIC SCHOOL THEME --- */
        :root {
            --primary: #006837;
            /* Emerald Green - Standard NU/Islamic */
            --primary-dark: #004d29;
            --primary-light: rgba(232, 245, 233, 0.9);
            --secondary: #2c3e50;
            /* Dark Navy */
            --accent: #f39c12;
            /* Gold */
            --accent-glow: rgba(243, 156, 18, 0.3);
            --bg-light: rgba(248, 249, 250, 0.85);
            --white: rgba(255, 255, 255, 0.95);
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--secondary);
            background-image: url('./bgfull_smp.jpeg');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            scroll-behavior: smooth;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .navbar-brand {
            font-family: 'Outfit', sans-serif;
        }

        /* --- NAVBAR --- */
        .navbar {
            background-image: linear-gradient(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.7)), url('./bgfull_smp.jpeg');
            background-size: cover;
            background-attachment: fixed;
            background-position: center top;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            padding: 15px 0;
            transition: all 0.3s;
        }

        .navbar-brand img {
            height: 50px;
        }

        .navbar-brand span {
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: var(--secondary) !important;
            font-weight: 600;
            margin: 0 10px;
            position: relative;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--primary) !important;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 50%;
            background-color: var(--primary);
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .btn-ppdb-nav {
            background-color: #ff5e00;
            /* Bright orange */
            color: white !important;
            border-radius: 50px;
            padding: 10px 25px;
            box-shadow: 0 5px 20px rgba(255, 94, 0, 0.4);
            transition: all 0.3s;
            border: none;
            font-weight: 700 !important;
        }

        .btn-ppdb-nav:hover,
        .btn-ppdb-nav:active,
        .btn-ppdb-nav:focus {
            background-color: #ff4500 !important;
            /* Deeper orange on interaction */
            color: white !important;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 8px 25px rgba(255, 94, 0, 0.6);
        }

        .btn-ppdb-nav::after {
            display: none;
        }

        /* --- HERO --- */
        .hero-section {
            padding: 150px 0 100px;
            /* Overlay gradient di atas background body - more transparent */
            background: linear-gradient(rgba(0, 70, 30, 0.75), rgba(0, 50, 0, 0.65)), url('./bgfull_smp.jpeg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            line-height: 1.2;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .hero-content p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            opacity: 1;
            font-weight: 400;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

        /* --- FEATURES --- */
        .feature-card {
            background: rgba(255, 255, 255, 0.8) !important;
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            box-shadow: var(--card-shadow);
            transition: all 0.3s;
            height: 100%;
            border-bottom: 5px solid transparent;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            border-bottom-color: var(--primary);
        }

        .feature-icon {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 20px;
            width: 80px;
            height: 80px;
            line-height: 80px;
            border-radius: 50%;
            background: var(--primary-light);
            display: inline-block;
        }

        /* --- INSTAGRAM / GALLERY --- */
        .instagram-section {
            background-color: white;
            padding: 80px 0;
        }

        .insta-placeholder {
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
            border-radius: 20px;
            padding: 3px;
            /* Gradient border width */
            margin-top: 30px;
        }

        .insta-content {
            background: rgba(255, 255, 255, 0.8);
            border-radius: 17px;
            padding: 40px;
            text-align: center;
        }

        .insta-gallery .col-4 {
            padding: 5px;
        }

        .insta-gallery img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
        }

        .insta-gallery img:hover {
            transform: scale(1.05);
            filter: brightness(0.9);
        }

        /* --- PPDB --- */
        .ppdb-section {
            background-color: var(--primary-light);
            padding: 80px 0;
            position: relative;
        }

        .timeline-steps {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
        }

        .timeline-step {
            align-items: center;
            display: flex;
            flex-direction: column;
            position: relative;
            margin: 1rem
        }

        /* Adjusting sections to show background slightly */
        section {
            position: relative;
            z-index: 1;
        }

        #about,
        #gallery,
        #ppdb {
            background-color: rgba(255, 255, 255, 0.2) !important;
            backdrop-filter: blur(5px);
        }

        .feature-card,
        #ppdb .card {
            background: rgba(255, 255, 255, 0.8) !important;
        }

        #ppdb .card-body {
            background: transparent !important;
        }

        /* --- FOOTER --- */
        footer {
            background-color: #111;
            color: #bdc3c7;
            padding: 60px 0 20px;
        }

        footer h5 {
            color: white;
            margin-bottom: 25px;
            font-weight: 700;
        }

        footer a {
            color: #bdc3c7;
            text-decoration: none;
            transition: 0.3s;
        }

        footer a:hover {
            color: var(--accent);
            padding-left: 5px;
        }

        /* --- IG horizontal marquee for Instagram Feed --- */
        .ig-marquee-wrapper {
            overflow: hidden;
            position: relative;
            width: 100%;
        }

        .ig-marquee-track {
            display: flex;
            gap: 16px;
            width: max-content;
            will-change: transform;
            animation: ig-smp-marquee 30s linear infinite;
        }

        .ig-marquee-track:hover {
            animation-play-state: paused;
        }

        .ig-card {
            min-width: 220px;
            max-width: 220px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            flex-shrink: 0;
            text-align: left;
            text-decoration: none;
            color: inherit;
            display: block;
            transition: 0.3s;
        }

        .ig-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12);
        }

        .ig-card-media {
            position: relative;
            width: 100%;
            height: 160px;
            overflow: hidden;
            background: #111;
        }

        .ig-card img,
        .ig-card video.ig-video {
            width: 100%;
            height: 160px;
            object-fit: cover;
            display: block;
        }

        .ig-card-video-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.6);
            color: white;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            pointer-events: none;
        }

        .ig-card-body {
            padding: 10px 12px;
        }

        .ig-card-title {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .ig-card-meta {
            font-size: 0.75rem;
            color: #7f8c8d;
        }

        @keyframes ig-smp-marquee {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <script>window.PAGE_KEY = 'smp';</script>
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="logo-smp.jpg" alt="Logo SMP" class="me-2">
                <div class="d-flex flex-column">
                    <span>SMP RADEN RAHMAT</span>
                    <small style="font-size: 0.7rem; font-weight: 400; color: #666;">BALONGBENDO - SIDOARJO</small>
                </div>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link active" href="#home">Beranda</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">Tentang Kami</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#gallery">Kegiatan (IG)</a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="nav-link btn-ppdb-nav" href="#ppdb"><i class="fas fa-file-pen me-2"></i> PPDB
                            ONLINE</a>
                    </li>
                    <li class="nav-item ms-3">
                        <a class="btn btn-outline-dark btn-sm rounded-circle"
                            href="https://radenrahmatbalongbendo.sch.id/" title="Kembali ke Portal Utama"><i
                                class="fas fa-arrow-left"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero-section text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 animate__animated animate__fadeInUp">
                    <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill fw-bold">PENERIMAAN SISWA BARU
                        2026/2027 DIBUKA!</span>
                    <h1>Generasi Cerdas,<br>Berkarakter & Berprestasi</h1>
                    <p class="mx-auto" style="max-width: 700px;">SMP Raden Rahmat Balongbendo berkomitmen mencetak
                        generasi muda yang unggul dalam IPTEK dan kokoh dalam IMTAQ berlandaskan Ahlussunnah Wal Jamaah.
                    </p>
                    <div class="d-flex gap-3 justify-content-center mt-4">
                        <a href="#ppdb" class="btn btn-warning btn-lg fw-bold rounded-pill px-5 shadow">DAFTAR
                            SEKARANG</a>
                        <a href="#about" class="btn btn-outline-light btn-lg rounded-pill px-4">Profil Sekolah</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features / Value Props -->
    <section id="about" class="py-5">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h6 class="text-primary fw-bold text-uppercase ls-1">Kenapa Memilih Kami?</h6>
                <h2 class="fw-bold display-6">Keunggulan SMP Raden Rahmat</h2>
                <div class="mx-auto mt-3" style="width: 60px; height: 3px; background: var(--primary);"></div>
            </div>

            <div class="row g-4" id="smp-features-container">
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-quran"></i>
                        </div>
                        <h4>Tahfidz & Diniyah</h4>
                        <p class="text-muted">Program unggulan tahfidz Juz 30 dan materi keagamaan mendalam (Fiqh,
                            Aqidah, Akhlak) untuk membentuk karakter Islami.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-laptop-code"></i>
                        </div>
                        <h4>Berbasis Teknologi</h4>
                        <p class="text-muted">pembelajaran modern didukung laboratorium komputer, multimedia, dan akses
                            internet untuk menunjang kompetensi digital.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <h4>Ekstrakurikuler Juara</h4>
                        <p class="text-muted">Beragam kegiatan ekstrakurikuler mulai dari Pramuka, Pagar Nusa, Banjari,
                            hingga Olahraga untuk menyalurkan bakat siswa.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Instagram Feed Section -->
    <section id="gallery" class="instagram-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <h2 class="fw-bold mb-3">Dokumentasi & Kegiatan</h2>
                    <p class="text-muted mb-4">Ikuti keseruan dan update terbaru dari kegiatan siswa-siswi SMP Raden
                        Rahmat melalui Instagram resmi kami.</p>

                    <a href="https://www.instagram.com/osis_smprrahmat/" target="_blank"
                        class="btn btn-outline-danger rounded-pill px-4 py-2"
                        style="box-shadow: 0 0 18px 6px rgba(255,255,255,0.85), 0 4px 15px rgba(220,39,80,0.25); background-color: rgba(255,255,255,0.18); font-weight: 600;">
                        <i class="fab fa-instagram me-2"></i> @osis_smprrahmat
                    </a>

                    <div class="mt-4 p-4 bg-light rounded-3 border-start border-4 border-success" id="prestasi-box">
                        <h5 class="fw-bold text-success mb-2">Prestasi Terbaru</h5>
                        <div class="mb-0 bg-white p-3 rounded shadow-sm border mt-2" id="prestasi-list">
                            <p class="mb-0 text-muted small">Memuat prestasi terbaru dari Instagram...</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="insta-placeholder animate__animated animate__fadeInRight">
                        <div class="insta-content">
                            <div class="d-flex align-items-center justify-content-center mb-4 text-muted">
                                <i class="fab fa-instagram fa-3x me-3 text-danger"></i>
                                <div class="text-start">
                                    <h5 class="mb-0 fw-bold text-dark">Instagram Feed</h5>
                                    <small>Terhubung secara langsung</small>
                                </div>
                            </div>

                            <!-- Dynamic Insta Feed -->
                            <div class="ig-feed-container mt-4">
                                <!-- Posts will be loaded here dynamically -->
                                <div class="text-center py-4" id="smp-ig-loading">
                                    <div class="spinner-border text-danger" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PPDB Section -->
    <section id="ppdb" class="ppdb-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 animate__animated animate__zoomIn">
                    <div class="card border-0 shadow-lg overflow-hidden rounded-4">
                        <div class="card-header bg-success text-white text-center p-4">
                            <h2 class="fw-bold mb-0">Formulir Pendaftaran Siswa Baru</h2>
                            <p class="mb-0 opacity-75">Tahun Ajaran 2026/2027</p>
                        </div>
                        <div class="card-body p-5">
                            <p class="text-center mb-4 text-muted">Silakan isi data awal berikut untuk terhubung
                                langsung dengan Panitia PPDB kami via WhatsApp.</p>

                            <form id="form-ppdb">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Nama Lengkap Siswa</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fas fa-user"></i></span>
                                        <input type="text" id="nama" class="form-control form-control-lg"
                                            placeholder="Masukkan nama lengkap" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Asal Sekolah (SD/MI)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fas fa-school"></i></span>
                                        <input type="text" id="sekolah" class="form-control form-control-lg"
                                            placeholder="Nama asal sekolah" required>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Nama Orang Tua/Wali</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light"><i
                                                    class="fas fa-user-friends"></i></span>
                                            <input type="text" id="ortu" class="form-control" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">No. HP / WhatsApp</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light"><i
                                                    class="fab fa-whatsapp text-success"></i></span>
                                            <input type="number" id="hp" class="form-control" placeholder="08......"
                                                required>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="button" onclick="kirimFormulir()"
                                        class="btn btn-warning btn-lg fw-bold text-dark shadow-sm">
                                        <i class="fab fa-whatsapp me-2"></i> KIRIM DATA PENDAFTARAN
                                    </button>
                                </div>
                                <p class="text-center small text-muted mt-3 mb-0">*Data akan dikirim ke WhatsApp Admin
                                    PPDB SMP Raden Rahmat.</p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
