      position: relative;
      overflow: hidden;
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    h1 {
      font-size: 36px;
      font-weight: 500;
      color: #FFFFFF;
    }

    .subtitle, .section-title, .feature-description {
      color: #F0F4FA;
    }

    .feature-title {
      color: #FFFFFF;
    }

    .link-arrow, .docs-link {
      color: #318AFF;
    }

    .footer {
      color: #888888;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .footer a {
      color: #a8a8a8;
    }

    .footer-disclaimer, .footer-copyright {
      color: #888888;
